<%= layout("/layouts/boiler_plate.ejs") %>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

<style>
  :root {
    --atithi-orange: #FF9432;
    --atithi-green: #67B636;
    --atithi-blue: #00A3E0;
    --airbnb-red: #FF385C; 
    --text-slate-dark: #222222; 
    --text-slate-muted: #717171; 
    --font-premium-stack: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  body {
    background-color: #ffffff !important; 
    font-family: var(--font-premium-stack);
    -webkit-font-smoothing: antialiased;
    letter-spacing: -0.1px;
    overflow-x: hidden;
  }

  /* === 🚀 GLOBAL SCROLLBAR === */
  ::-webkit-scrollbar {
    width: 8px;
    height: 6px;
    background-color: rgba(15, 23, 42, 0.02);
  }
  ::-webkit-scrollbar-track {
    background: rgba(15, 23, 42, 0.05);
    backdrop-filter: blur(10px);
  }
  ::-webkit-scrollbar-thumb {
    background: linear-gradient(180deg, var(--atithi-orange) 0%, var(--atithi-green) 50%, var(--atithi-blue) 100%);
    border-radius: 100px;
  }

  /* === 🌟 AIRBNB CARDS GRID ENGINE === */
  .atithi-outer-wrapper {
    padding: 0 3.5% !important; 
    width: 100%;
    max-width: 100vw;
    box-sizing: border-box;
  }

  .atithi-grid-engine {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 24px 20px; 
    width: 100%;
  }

  .atithi-premium-card {
    background: transparent !important; 
    border: none !important; 
    border-radius: 0 !important;
    box-shadow: none !important; 
    width: 100%;
    position: relative;
    opacity: 0;
    transform: translateY(15px);
    animation: cardEntranceCascade 0.45s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    cursor: pointer;
  }

  @keyframes cardEntranceCascade {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .image-wrapper-node {
    position: relative;
    overflow: hidden;
    border-radius: 16px; 
    width: 100%;
    aspect-ratio: 1 / 0.95; 
    background-color: #f1f5f9;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .card-img-top {
    height: 100%;
    object-fit: cover;
    width: 100%;
    transition: transform 0.4s cubic-bezier(0.2, 0, 0, 1); 
  }
  
  .atithi-premium-card:hover .card-img-top {
    transform: scale(1.05);
  }

  .fav-btn-pod {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 10;
  }
  .fav-btn {
    background: transparent !important;
    border: none;
    font-size: 1.35rem;
    color: rgba(0, 0, 0, 0.4); 
    -webkit-text-stroke: 2px #ffffff; 
    transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .fav-btn:hover, .fav-btn.active-wishlist {
    transform: scale(1.15);
    color: var(--airbnb-red) !important;
    -webkit-text-stroke: 2px var(--airbnb-red);
  }

  .arrived-new-banner {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 10;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(8px);
    color: #222222;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 20px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
    letter-spacing: 0.2px;
  }

  .card-body-meta {
    padding: 10px 0 0 0; 
  }

  .meta-title-rating-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 2px;
  }

  .listing-title-text {
    font-size: 14.5px;
    font-weight: 600; 
    color: var(--text-slate-dark);
    margin-bottom: 0;
    text-overflow: ellipsis;
    white-space: nowrap;
    overflow: hidden;
    line-height: 1.35;
  }

  .rating-badge-container {
    font-size: 13.5px;
    font-weight: 500;
    color: var(--text-slate-dark);
    display: flex;
    align-items: center;
    gap: 4px;
    line-height: 1.35;
    flex-shrink: 0;
  }
  .rating-badge-container i {
    font-size: 11px;
    color: #222222; 
  }

  .listing-geo-text {
    font-size: 13.5px;
    color: var(--text-slate-muted);
    font-weight: 400;
    margin-bottom: 3px;
    line-height: 1.35;
    text-overflow: ellipsis;
    white-space: nowrap;
    overflow: hidden;
  }

  .listing-pricing-node {
    font-size: 14px;
    font-weight: 400;
    color: var(--text-slate-dark);
    line-height: 1.35;
    margin-bottom: 0;
  }
  .listing-pricing-node strong {
    font-weight: 600;
  }

  /* ⚡ ROBUST TAX INFORMATION CONTAINER */
  .tax-info {
    display: none;
    font-size: 13.5px;
    font-weight: 400;
    color: var(--text-slate-muted);
    margin-top: 4px;
    line-height: 1.35;
    text-decoration: underline;
    opacity: 0;
    transform: translateY(3px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .tax-info.visible-tax {
    display: block !important;
    opacity: 1 !important;
    transform: translateY(0) !important;
  }

  .tax-amount-highlight {
    font-weight: 600;
    color: var(--text-slate-dark);
  }

  /* Responsive Grid Breakpoints */
  @media (max-width: 1800px) {
    .atithi-grid-engine { grid-template-columns: repeat(6, minmax(0, 1fr)); }
  }
  @media (max-width: 1550px) {
    .atithi-grid-engine { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  }
  @media (max-width: 1250px) {
    .atithi-grid-engine { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  @media (max-width: 992px) {
    .atithi-grid-engine { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 768px) {
    .atithi-outer-wrapper { padding: 0 16px !important; }
    .atithi-grid-engine { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 14px; }
  }
  @media (max-width: 480px) {
    .atithi-grid-engine { grid-template-columns: repeat(1, minmax(0, 1fr)); }
  }
</style>

<!-- ⚡ 1. REUSABLE FLOATING FILTER & TAX CONSOLE -->
<%- include("../includes/filter_bar.ejs") %>

<!-- 🌟 2. CARDS GRID MATRIX -->
<div class="atithi-outer-wrapper mt-1 mb-5">
  <div class="atithi-grid-engine">
    <% datas.forEach((data, index) => { %>
      <div class="atithi-premium-card" style="animation-delay: <%= Math.min(index * 0.03, 0.4) %>s">
        
        <div class="image-wrapper-node">
          <% 
            let displayUrl = "/images/default.jpg";
            if(data.images && data.images.length > 0 && data.images[0].url) {
              displayUrl = data.images[0].url.replace('/upload', '/upload/w_480,h_460,c_fill,q_auto,f_auto');
            }
          %>
          <img 
            src="<%= displayUrl %>" 
            class="card-img-top" 
            alt="<%= data.title %>"
            loading="lazy">
          
          <% if(!data.reviews || data.reviews.length === 0) { %>
            <div class="arrived-new-banner">Guest favorite</div>
          <% } %>

          <div class="fav-btn-pod" onclick="event.stopPropagation(); event.preventDefault();">
            <button class="fav-btn" onclick="this.classList.toggle('active-wishlist')">
              <i class="fa-solid fa-heart"></i>
            </button>
          </div>
        </div>

        <div class="card-body-meta">
          <div class="meta-title-rating-row">
            <h6 class="listing-title-text"><%= data.title %></h6>
            
            <% if(data.reviews && data.reviews.length > 0) { %>
              <% 
                let sum = 0; 
                data.reviews.forEach(r => sum += (Number(r.rating) || 0)); 
                let avg = (sum / data.reviews.length).toFixed(2); 
              %>
              <div class="rating-badge-container">
                <i class="fa-solid fa-star"></i><span><%= avg %></span>
              </div>
            <% } else { %>
              <div class="rating-badge-container">
                <i class="fa-solid fa-star"></i><span>New</span>
              </div>
            <% } %>
          </div>

          <p class="listing-geo-text"><%= data.location %>, <%= data.country %></p>
          
          <!-- Base Nightly Price -->
          <p class="listing-pricing-node">
            <strong>
              <span class="currency-convert-target" data-base-price="<%= data.price %>">&#8377;<%= Number(data.price).toLocaleString("en-IN") %></span>
            </strong> / night
          </p>
          
          <!-- Total Price with 12% GST Tax -->
          <% 
            let taxAmount = Math.round(data.price * 0.12);
            let totalWithTax = data.price + taxAmount;
          %>
          <div class="tax-info">
            <span class="tax-amount-highlight currency-tax-target" data-tax-base="<%= totalWithTax %>">&#8377;<%= Number(totalWithTax).toLocaleString("en-IN") %></span> total after taxes
          </div>
          
          <a href="/listings/<%= data._id %>" class="stretched-link" aria-label="<%= data.title %>"></a>
        </div>

      </div>
    <% }) %>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const exchangeRates = {
      INR: { symbol: "₹", rate: 1 },
      USD: { symbol: "$", rate: 0.012 },
      EUR: { symbol: "€", rate: 0.011 },
      GBP: { symbol: "£", rate: 0.0095 },
      JPY: { symbol: "¥", rate: 1.85 },
      AED: { symbol: "د.إ", rate: 0.044 },
      CAD: { symbol: "CA$", rate: 0.016 },
      AUD: { symbol: "AU$", rate: 0.018 },
      SGD: { symbol: "SG$", rate: 0.016 }
    };

    window.syncIndexPricesWithSavedCurrency = function() {
      const savedCurr = localStorage.getItem("atithi_currency") || "INR";
      const config = exchangeRates[savedCurr] || exchangeRates.INR;

      // 1. Convert Nightly Base Prices
      document.querySelectorAll(".currency-convert-target[data-base-price]").forEach(el => {
        const base = parseFloat(el.getAttribute("data-base-price"));
        if (!isNaN(base)) {
          const converted = Math.round(base * config.rate);
          el.innerHTML = `<bdi>${config.symbol}</bdi>${converted.toLocaleString()}`;
        }
      });

      // 2. Convert Total With Tax Prices
      document.querySelectorAll(".currency-tax-target[data-tax-base]").forEach(el => {
        const taxBase = parseFloat(el.getAttribute("data-tax-base"));
        if (!isNaN(taxBase)) {
          const converted = Math.round(taxBase * config.rate);
          el.innerHTML = `<bdi>${config.symbol}</bdi>${converted.toLocaleString()}`;
        }
      });
    };

    // Run on initial load
    window.syncIndexPricesWithSavedCurrency();

    // Listen to custom dispatch from navbar
    window.addEventListener("atithi_currency_updated", window.syncIndexPricesWithSavedCurrency);
    window.addEventListener("storage", (e) => {
      if (e.key === "atithi_currency") {
        window.syncIndexPricesWithSavedCurrency();
      }
    });
  });
</script>