<%= layout("/layouts/boiler_plate.ejs") %>

<style>
  :root {
    --atithi-orange: #FF9432;
    --atithi-green: #67B636;
    --atithi-blue: #00A3E0;
    
    --card-surface: rgba(12, 19, 36, 0.94);
    --card-border: rgba(255, 255, 255, 0.18);
    --input-surface: rgba(18, 28, 52, 0.88);
    --input-border: rgba(255, 255, 255, 0.22);
    --text-slate-light: #f8fafc;
    --text-slate-muted: #94a3b8;
    --font-premium: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", Roboto, sans-serif;
  }

  /* === KINETIC BRAND SCROLLBAR === */
  ::-webkit-scrollbar {
    width: 10px;
  }
  ::-webkit-scrollbar-track {
    background: #060a14;
  }
  ::-webkit-scrollbar-thumb {
    background: linear-gradient(180deg, var(--atithi-green) 0%, var(--atithi-blue) 50%, var(--atithi-orange) 100%);
    border-radius: 100px;
    border: 2px solid #060a14;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(180deg, #7ecc4c 0%, #29beff 50%, #ffaa5b 100%);
  }

  /* === 1. FIXED BACKGROUND SCENERY (SIGNUP EDITION) === */
  .fixed-fullscreen-viewport {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .body-scenery-pane {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
    opacity: 0;
    animation: panoramicKenBurns 24s infinite ease-in-out;
  }

  /* Distinct High-Resolution Architecture & Sanctuary Visuals */
  .body-scenery-pane:nth-child(1) {
    background-image: linear-gradient(rgba(6, 10, 22, 0.50), rgba(6, 10, 22, 0.84)), 
                      url('https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=2200&q=85');
    animation-delay: 0s;
  }
  .body-scenery-pane:nth-child(2) {
    background-image: linear-gradient(rgba(6, 10, 22, 0.50), rgba(6, 10, 22, 0.84)), 
                      url('https://images.unsplash.com/photo-1571896349842-33c89424de2d?auto=format&fit=crop&w=2200&q=85');
    animation-delay: 6s;
  }
  .body-scenery-pane:nth-child(3) {
    background-image: linear-gradient(rgba(6, 10, 22, 0.50), rgba(6, 10, 22, 0.84)), 
                      url('https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=2200&q=85');
    animation-delay: 12s;
  }
  .body-scenery-pane:nth-child(4) {
    background-image: linear-gradient(rgba(6, 10, 22, 0.50), rgba(6, 10, 22, 0.84)), 
                      url('https://images.unsplash.com/photo-1520250497591-112f2f40a3f4?auto=format&fit=crop&w=2200&q=85');
    animation-delay: 18s;
  }

  @keyframes panoramicKenBurns {
    0% { opacity: 0; transform: scale(1); }
    8% { opacity: 1; }
    25% { opacity: 1; }
    33% { opacity: 0; transform: scale(1.08) translate3d(-10px, -6px, 0); }
    100% { opacity: 0; transform: scale(1); }
  }

  /* Ambient Dynamic Glow */
  .aurora-ambient-glow {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }
  .aurora-orb-1 {
    position: absolute;
    top: 18%;
    left: 8%;
    width: 540px;
    height: 540px;
    background: radial-gradient(circle, rgba(103, 182, 54, 0.22) 0%, transparent 70%);
    filter: blur(100px);
  }
  .aurora-orb-2 {
    position: absolute;
    bottom: 12%;
    right: 14%;
    width: 580px;
    height: 580px;
    background: radial-gradient(circle, rgba(255, 148, 50, 0.24) 0%, transparent 70%);
    filter: blur(110px);
  }

  /* === 2. MAIN HERO SECTION WRAPPER === */
  .auth-hero-viewport {
    position: relative;
    z-index: 2;
    min-height: calc(100vh - 120px);
    display: flex;
    align-items: center;
    padding: 30px 0 60px 0;
  }

  .auth-split-grid {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 55px;
  }

  /* === 3. LEFT BRAND STORYTELLING === */
  .brand-narrative-col {
    flex: 1;
    max-width: 580px;
  }

  .brand-pill-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 20px;
    background: rgba(103, 182, 54, 0.16);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(103, 182, 54, 0.45);
    border-radius: 40px;
    color: var(--atithi-green);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.4px;
    margin-bottom: 24px;
    box-shadow: 0 4px 16px rgba(103, 182, 54, 0.2);
  }

  .brand-headline-hero {
    font-size: 40px;
    font-weight: 800;
    line-height: 1.22;
    color: #ffffff;
    letter-spacing: -1.2px;
    margin-bottom: 20px;
    text-shadow: 0 4px 28px rgba(0, 0, 0, 0.9);
  }

  .gradient-shimmer-title {
    background: linear-gradient(90deg, #ffffff 0%, var(--atithi-green) 40%, var(--atithi-blue) 75%, var(--atithi-orange) 100%);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: textShimmerSweep 6s linear infinite;
  }
  @keyframes textShimmerSweep {
    to { background-position: 200% center; }
  }

  .brand-paragraph-desc {
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--text-slate-muted);
    margin-bottom: 34px;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.8);
  }

  .metrics-frosted-capsule {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    background: rgba(12, 20, 38, 0.65);
    backdrop-filter: blur(25px);
    -webkit-backdrop-filter: blur(25px);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 22px;
    padding: 18px 22px;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.45);
  }

  .stat-block {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .stat-number {
    font-size: 21px;
    font-weight: 800;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .stat-number.green { color: var(--atithi-green); }
  .stat-number.blue { color: var(--atithi-blue); }
  .stat-number.orange { color: var(--atithi-orange); }

  .stat-title {
    font-size: 12px;
    color: #94a3b8;
    font-weight: 600;
  }

  /* === 4. ULTRA-PREMIUM SIGNUP CARD === */
  .auth-card-anchor {
    position: relative;
    width: 100%;
    max-width: 440px;
  }

  .auth-card-anchor::before {
    content: '';
    position: absolute;
    inset: -15px;
    background: radial-gradient(circle at 50% 0%, rgba(103, 182, 54, 0.35), rgba(255, 148, 50, 0.25), transparent 75%);
    filter: blur(32px);
    border-radius: 40px;
    z-index: 0;
    pointer-events: none;
  }

  .auth-card-container {
    position: relative;
    z-index: 1;
    width: 100%;
    background: var(--card-surface);
    backdrop-filter: blur(50px) saturate(220%);
    -webkit-backdrop-filter: blur(50px) saturate(220%);
    border: 1px solid var(--card-border);
    border-radius: 30px;
    padding: 40px 34px;
    box-shadow: 0 35px 90px rgba(0, 0, 0, 0.95), inset 0 1px 2px rgba(255, 255, 255, 0.3);
    overflow: hidden;
  }

  /* Flowing Gradient Top Border */
  .auth-card-container::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3.5px;
    background: linear-gradient(90deg, var(--atithi-green), var(--atithi-blue), var(--atithi-orange), var(--atithi-green));
    background-size: 300% 100%;
    animation: beamLaserFlow 5s linear infinite;
  }
  @keyframes beamLaserFlow {
    0% { background-position: 0% 50%; }
    100% { background-position: 300% 50%; }
  }

  .card-intro-block h2 {
    font-size: 26px;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.6px;
    margin-bottom: 5px;
  }
  .card-intro-block p {
    font-size: 13.5px;
    color: var(--text-slate-muted);
    font-weight: 500;
    margin-bottom: 24px;
  }

  .field-label-tag {
    display: block;
    font-size: 11.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.7px;
    color: #cbd5e1;
    margin-bottom: 7px;
  }

  .input-icon-harness {
    position: relative;
    display: flex;
    align-items: center;
    margin-bottom: 16px;
  }

  .input-icon-harness .lead-icon {
    position: absolute;
    left: 16px;
    color: #94a3b8;
    font-size: 17px;
    pointer-events: none;
    transition: all 0.25s ease;
  }

  .input-icon-harness .action-icon {
    position: absolute;
    right: 16px;
    color: #94a3b8;
    font-size: 17px;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .input-icon-harness .action-icon:hover {
    color: #ffffff;
    transform: scale(1.15);
  }

  .input-glass-control {
    width: 100%;
    background: var(--input-surface) !important;
    border: 1px solid var(--input-border) !important;
    border-radius: 14px !important;
    padding: 13px 44px 13px 44px !important;
    font-size: 14px !important;
    font-weight: 500 !important;
    color: #ffffff !important;
    box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.35);
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .input-glass-control::placeholder {
    color: #94a3b8 !important;
    opacity: 1 !important;
    font-size: 13.5px !important;
    font-weight: 400 !important;
  }

  .input-glass-control:focus {
    background: rgba(22, 34, 62, 0.98) !important;
    border-color: var(--atithi-green) !important;
    box-shadow: 0 0 0 3px rgba(103, 182, 54, 0.32), 0 8px 24px rgba(0, 0, 0, 0.45) !important;
    transform: translateY(-1.5px);
    outline: none !important;
  }

  .input-glass-control:focus ~ .lead-icon {
    color: var(--atithi-green);
    transform: scale(1.15);
  }

  .btn-auth-master-submit {
    position: relative;
    width: 100%;
    background: linear-gradient(135deg, var(--atithi-green) 0%, #3e8812 100%);
    color: #ffffff;
    font-weight: 700;
    font-size: 15.5px;
    letter-spacing: 0.2px;
    border: none;
    border-radius: 14px;
    padding: 13px;
    cursor: pointer;
    box-shadow: 0 6px 24px rgba(103, 182, 54, 0.45);
    transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    overflow: hidden;
    margin-top: 6px;
  }
  .btn-auth-master-submit:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 32px rgba(103, 182, 54, 0.65);
  }

  .auth-divider-node {
    display: flex;
    align-items: center;
    text-align: center;
    margin: 18px 0;
  }
  .auth-divider-node::before,
  .auth-divider-node::after {
    content: '';
    flex: 1;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }
  .auth-divider-node span {
    padding: 0 12px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: #94a3b8;
  }

  .btn-google-social-gateway {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 100%;
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    font-size: 14.5px;
    font-weight: 600;
    padding: 12px 18px;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    text-decoration: none;
    box-sizing: border-box;
    transition: all 0.25s ease;
  }
  .btn-google-social-gateway:hover {
    background: rgba(255, 255, 255, 0.16);
    border-color: rgba(255, 255, 255, 0.4);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
    color: #ffffff;
  }
  .btn-google-social-gateway img {
    width: 20px !important;
    height: 20px !important;
    object-fit: contain !important;
    flex-shrink: 0 !important;
  }

  .switch-auth-portal {
    text-align: center;
    margin-top: 18px;
    font-size: 13.5px;
    color: var(--text-slate-muted);
  }
  .switch-auth-portal a {
    color: var(--atithi-orange);
    text-decoration: none;
    font-weight: 700;
    margin-left: 4px;
  }
  .switch-auth-portal a:hover {
    text-decoration: underline;
  }

  /* === 5. NEW UNIQUE DESTINATIONS SHOWCASE (4 + 4) === */
  .destinations-grand-matrix {
    position: relative;
    z-index: 2;
    padding: 70px 0 100px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .cluster-header-block {
    text-align: center;
    margin-bottom: 45px;
  }
  .cluster-header-block h3 {
    font-size: 32px;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.6px;
    margin-bottom: 6px;
  }
  .cluster-header-block p {
    color: var(--text-slate-muted);
    font-size: 15px;
  }

  .stays-grid-deck {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 24px;
  }

  .stay-glass-card {
    background: rgba(12, 20, 36, 0.88);
    backdrop-filter: blur(25px);
    -webkit-backdrop-filter: blur(25px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 22px;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    flex-direction: column;
  }
  .stay-glass-card:hover {
    transform: translateY(-8px);
    border-color: rgba(103, 182, 54, 0.5);
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.7);
  }

  .stay-thumbnail-wrapper {
    position: relative;
    height: 180px;
    width: 100%;
    overflow: hidden;
  }
  .stay-thumbnail-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .stay-glass-card:hover .stay-thumbnail-wrapper img {
    transform: scale(1.08);
  }

  .stay-rate-pill {
    position: absolute;
    top: 14px;
    right: 14px;
    background: rgba(10, 16, 30, 0.85);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: var(--atithi-green);
    font-size: 12px;
    font-weight: 800;
    padding: 5px 12px;
    border-radius: 20px;
  }

  .stay-details-pad {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  .stay-details-pad h4 {
    color: #ffffff;
    font-size: 17.5px;
    font-weight: 700;
    margin-bottom: 6px;
  }
  .stay-geo-tag {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--atithi-orange);
    font-weight: 600;
    margin-bottom: 10px;
  }
  .stay-details-pad p {
    color: #94a3b8;
    font-size: 13px;
    line-height: 1.5;
    margin: 0;
  }

  .cluster-spacer-tier {
    margin-top: 80px;
  }

  @media (max-width: 991px) {
    .brand-narrative-col { display: none; }
    .auth-split-grid { justify-content: center; }
  }
</style>

<!-- Fixed Background Slideshow -->
<div class="fixed-fullscreen-viewport">
  <div class="body-scenery-pane"></div>
  <div class="body-scenery-pane"></div>
  <div class="body-scenery-pane"></div>
  <div class="body-scenery-pane"></div>
</div>

<!-- Ambient Lighting Aura -->
<div class="aurora-ambient-glow">
  <div class="aurora-orb-1"></div>
  <div class="aurora-orb-2"></div>
</div>

<!-- Hero Authentication Stage -->
<div class="auth-hero-viewport">
  <div class="auth-split-grid">
    
    <!-- Left Column: Unique Signup Storytelling -->
    <div class="brand-narrative-col">
      <div class="brand-pill-tag">
        <i class="bi bi-stars"></i> Join 15,000+ Verified Travelers
      </div>
      
      <h1 class="brand-headline-hero">
        Unlock extraordinary stays & <span class="gradient-shimmer-title">authentic regional hosting.</span>
      </h1>
      
      <p class="brand-paragraph-desc">
        Create your verified Atithi passport to split reservation tabs across friends, connect directly with regional superhosts, and secure zero-commission boutique retreats.
      </p>
      
      <!-- Unified Stats Capsule -->
      <div class="metrics-frosted-capsule">
        <div class="stat-block">
          <span class="stat-number green"><i class="bi bi-shield-check"></i> Zero</span>
          <span class="stat-title">Hidden Fees</span>
        </div>
        <div class="stat-block">
          <span class="stat-number blue"><i class="bi bi-currency-rupee"></i> Instant</span>
          <span class="stat-title">Direct Host Pay</span>
        </div>
        <div class="stat-block">
          <span class="stat-number orange"><i class="bi bi-award-fill"></i> Superhost</span>
          <span class="stat-title">Vetted Cleanliness</span>
        </div>
      </div>
    </div>

    <!-- Right Column: Luminescent Glass Signup Card -->
    <div class="auth-card-anchor">
      <div class="auth-card-container">
        
        <div class="card-intro-block">
          <h2>Create Your Passport</h2>
          <p>Begin your bespoke journey across India today</p>
        </div>

        <form action="/signup" method="post" class="needs-validation" novalidate>
          
          <!-- Username Input -->
          <label for="username" class="field-label-tag">Explorer Handle (Username)</label>
          <div class="input-icon-harness">
            <i class="bi bi-person lead-icon"></i>
            <input 
              type="text" 
              class="input-glass-control" 
              name="username" 
              id="username" 
              placeholder="e.g. atithi" 
              autocomplete="username"
              required
            >
            <div class="invalid-feedback">A unique username handle is required.</div>
          </div>

          <!-- Email Input -->
          <label for="email" class="field-label-tag">Email Address</label>
          <div class="input-icon-harness">
            <i class="bi bi-envelope lead-icon"></i>
            <input 
              type="email" 
              class="input-glass-control" 
              name="email" 
              id="email" 
              placeholder="atithi@example.com" 
              autocomplete="email"
              required
            >
            <div class="invalid-feedback">A valid email address is required.</div>
          </div>

          <!-- Password Input with Toggle -->
          <label for="password" class="field-label-tag">Secure Passkey</label>
          <div class="input-icon-harness">
            <i class="bi bi-shield-lock lead-icon"></i>
            <input 
              type="password" 
              class="input-glass-control" 
              name="password" 
              id="password" 
              placeholder="Create a strong password" 
              autocomplete="new-password"
              required
            >
            <i class="bi bi-eye action-icon" id="togglePasswordVisibility"></i>
            <div class="invalid-feedback">Password field cannot remain empty.</div>
          </div>

          <button class="btn-auth-master-submit" type="submit">Complete Registration</button>
        </form>

        <div class="auth-divider-node">
          <span>Or Register Via</span>
        </div>

        <!-- Google OAuth Gateway -->
        <a href="/auth/google" class="btn-google-social-gateway">
          <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" alt="Google">
          <span>Continue with Google ID</span>
        </a>

        <p class="switch-auth-portal mb-0">
          Already have an account? <a href="/login">Sign in</a>
        </p>

      </div>
    </div>

  </div>
</div>

<!-- 4. Extended 4 + 4 Indian Destinations Showcase (Unique Places) -->
<div class="destinations-grand-matrix">
  
  <!-- CLUSTER 1: Architectural Gems & Heritage Palaces -->
  <div class="cluster-header-block">
    <h3>Architectural Gems & Heritage Palaces</h3>
    <p>Discover sandstone courtyards, French colonial villas, and ancient stone estates.</p>
  </div>

  <div class="stays-grid-deck">
    <!-- Card 1: Jodhpur -->
    <div class="stay-glass-card">
      <div class="stay-thumbnail-wrapper">
        <img src="https://images.unsplash.com/photo-1598890777032-bde835ba27c2?auto=format&fit=crop&w=800&q=80" alt="Jodhpur Stay">
        <span class="stay-rate-pill">From ₹4,200/night</span>
      </div>
      <div class="stay-details-pad">
        <h4>Blue City Sandstone Haveli</h4>
        <span class="stay-geo-tag"><i class="bi bi-geo-alt"></i> Navchokiya, Jodhpur</span>
        <p>Rooftop dining gazing over Mehrangarh Fort, artisanal block-print decor, and sunlit inner sandstone courtyards.</p>
      </div>
    </div>

    <!-- Card 2: Pondicherry -->
    <div class="stay-glass-card">
      <div class="stay-thumbnail-wrapper">
        <img src="https://images.unsplash.com/photo-1582510003544-4d00b7f74220?auto=format&fit=crop&w=800&q=80" alt="Pondicherry Stay">
        <span class="stay-rate-pill">From ₹5,100/night</span>
      </div>
      <div class="stay-details-pad">
        <h4>White Town French Quarter Villa</h4>
        <span class="stay-geo-tag"><i class="bi bi-geo-alt"></i> White Town, Pondicherry</span>
        <p>Mustard-yellow colonial arches, bougainvillea verandas, private espresso balconies, and vintage teakwood fittings.</p>
      </div>
    </div>

    <!-- Card 3: Ooty -->
    <div class="stay-glass-card">
      <div class="stay-thumbnail-wrapper">
        <img src="https://images.unsplash.com/photo-1544735716-392fe2489ffa?auto=format&fit=crop&w=800&q=80" alt="Ooty Stay">
        <span class="stay-rate-pill">From ₹3,900/night</span>
      </div>
