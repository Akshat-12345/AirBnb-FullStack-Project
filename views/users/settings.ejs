<%= layout("/layouts/boiler_plate.ejs") %>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
  :root {
    --brand-orange: #FF9432;
    --brand-green: #67B636;
    --brand-blue: #00A3E0;
    --dark-slate: #0f172a;
  }

  .settings-container {
    max-width: 820px;
    margin: 40px auto 90px auto;
    padding: 0 20px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  .settings-header {
    margin-bottom: 30px;
  }
  .settings-header h2 {
    font-size: 30px;
    font-weight: 600;
    color: var(--dark-slate);
    letter-spacing: -0.6px;
    margin-bottom: 6px;
  }
  .settings-header p {
    color: #64748b;
    font-size: 14.5px;
  }

  .settings-main-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 24px;
    padding: 36px;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.05);
  }

  /* Profile Avatar Header Bar */
  .profile-hero-node {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-bottom: 24px;
    margin-bottom: 28px;
    border-bottom: 1px solid #f1f5f9;
  }
  .avatar-circle-hero {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--brand-orange), #ff5e3a);
    color: #ffffff;
    font-weight: 700;
    font-size: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
  }
  .avatar-circle-hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .section-label-group {
    font-size: 15px;
    font-weight: 600;
    color: var(--dark-slate);
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .custom-field-label {
    font-size: 13px;
    font-weight: 600;
    color: #334155;
    margin-bottom: 6px;
    display: block;
  }

  .input-control-styled {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid #cbd5e1;
    border-radius: 12px;
    font-size: 14.5px;
    color: #0f172a;
    outline: none;
    transition: all 0.2s ease;
  }
  .input-control-styled:focus {
    border-color: var(--dark-slate);
    box-shadow: 0 0 0 4px rgba(15, 23, 42, 0.08);
  }

  /* Password eye toggle wrapper */
  .password-input-group {
    position: relative;
    display: flex;
    align-items: center;
  }
  .btn-toggle-eye {
    position: absolute;
    right: 14px;
    background: transparent;
    border: none;
    color: #94a3b8;
    cursor: pointer;
    font-size: 17px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition: color 0.2s ease;
  }
  .btn-toggle-eye:hover {
    color: #0f172a;
  }

  /* OTP Send Pill Button */
  .btn-send-otp {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    color: #0f172a;
    padding: 10px 18px;
    border-radius: 12px;
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .btn-send-otp:hover {
    background: #f8fafc;
    border-color: #94a3b8;
  }
  .btn-send-otp:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .otp-alert-box {
    font-size: 13px;
    margin-top: 6px;
    display: none;
  }

  .divider-clean {
    height: 1px;
    background: #f1f5f9;
    margin: 30px 0;
  }

  .btn-submit-unified {
    background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
    color: #ffffff;
    border: none;
    padding: 14px 34px;
    border-radius: 14px;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.2);
    transition: all 0.2s ease;
  }
  .btn-submit-unified:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.3);
  }
</style>

<div class="settings-container">
  <div class="settings-header">
    <h2>Account Settings</h2>
    <p>Manage your account credentials, email verification and password security in one place.</p>
  </div>

  <div class="settings-main-card">
    
    <!-- User Avatar Context -->
    <div class="profile-hero-node">
      <div class="avatar-circle-hero">
        <% if(user.avatar) { %>
          <img src="<%= user.avatar %>" alt="<%= user.username %>" referrerpolicy="no-referrer">
        <% } else { %>
          <%= user.username.charAt(0).toUpperCase() %>
        <% } %>
      </div>
      <div>
        <h5 class="m-0 fw-bold text-dark">@<%= user.username %></h5>
        <span class="small text-muted"><%= user.email %></span>
      </div>
    </div>

    <!-- ⚡ SINGLE UNIFIED FORM -->
    <form action="/settings/update" method="POST" autocomplete="off">
      
      <!-- 1. USERNAME & EMAIL SECTION -->
      <div class="section-label-group">
        <i class="bi bi-person-gear text-primary"></i> Personal Details
      </div>

      <div class="row g-3 mb-3">
        <div class="col-md-6">
          <label class="custom-field-label" for="username">Username</label>
          <input type="text" id="username" name="username" class="input-control-styled" value="<%= user.username %>" required>
        </div>

        <div class="col-md-6">
          <label class="custom-field-label" for="email">Email Address</label>
          <div class="d-flex gap-2">
            <input type="email" id="email" name="email" class="input-control-styled" value="<%= user.email %>" data-original-email="<%= user.email %>" required>
            <button type="button" class="btn-send-otp d-none" id="sendOtpBtn">
              <i class="bi bi-envelope-arrow-up"></i> Send OTP
            </button>
          </div>
          <div id="otpStatusMsg" class="otp-alert-box"></div>
        </div>
      </div>

      <!-- OTP Dynamic Input Field (Hidden till email changes) -->
      <div class="mb-3 d-none" id="otpInputWrapper">
        <label class="custom-field-label text-warning" for="emailOtp">
          <i class="bi bi-shield-check"></i> Enter 6-digit Code sent to new email
        </label>
        <input type="text" id="emailOtp" name="otp" class="input-control-styled" placeholder="123456" maxlength="6" style="max-width: 200px; letter-spacing: 3px; font-weight: 700;">
      </div>

      <div class="divider-clean"></div>

      <!-- 2. PASSWORD SECURITY SECTION -->
      <div class="section-label-group">
        <i class="bi bi-shield-lock text-success"></i> Change Password
        <span class="text-muted fw-normal small ms-1">(Leave blank if you don't want to change password)</span>
      </div>

      <div class="mb-3">
        <label class="custom-field-label" for="currPass">Current Password</label>
        <div class="password-input-group">
          <input type="password" id="currPass" name="currentPassword" class="input-control-styled" placeholder="Enter current password">
          <button type="button" class="btn-toggle-eye" onclick="togglePasswordEye('currPass', this)">
            <i class="bi bi-eye"></i>
          </button>
        </div>
      </div>

      <div class="row g-3 mb-4">
        <div class="col-md-6">
          <label class="custom-field-label" for="newPass">New Password</label>
          <div class="password-input-group">
            <input type="password" id="newPass" name="newPassword" class="input-control-styled" placeholder="At least 6 characters">
            <button type="button" class="btn-toggle-eye" onclick="togglePasswordEye('newPass', this)">
              <i class="bi bi-eye"></i>
            </button>
          </div>
        </div>

        <div class="col-md-6">
          <label class="custom-field-label" for="confirmPass">Confirm New Password</label>
          <div class="password-input-group">
            <input type="password" id="confirmPass" name="confirmPassword" class="input-control-styled" placeholder="Repeat new password">
            <button type="button" class="btn-toggle-eye" onclick="togglePasswordEye('confirmPass', this)">
              <i class="bi bi-eye"></i>
            </button>
          </div>
        </div>
      </div>

      <!-- FORM ACTIONS -->
      <div class="text-end pt-2">
        <button type="submit" class="btn-submit-unified">Save Account Changes</button>
      </div>

    </form>
  </div>
</div>

<script>
  // 1. Password Eye Toggle Helper
  function togglePasswordEye(inputId, btn) {
    const input = document.getElementById(inputId);
    const icon = btn.querySelector("i");
    if (!input) return;

    if (input.type === "password") {
      input.type = "text";
      icon.classList.remove("bi-eye");
      icon.classList.add("bi-eye-slash");
    } else {
      input.type = "password";
      icon.classList.remove("bi-eye-slash");
      icon.classList.add("bi-eye");
    }
  }

  // 2. Email OTP Flow Handling
  document.addEventListener("DOMContentLoaded", () => {
    const emailInput = document.getElementById("email");
    const sendOtpBtn = document.getElementById("sendOtpBtn");
    const otpWrapper = document.getElementById("otpInputWrapper");
    const otpInput = document.getElementById("emailOtp");
    const otpStatus = document.getElementById("otpStatusMsg");
    const originalEmail = emailInput.dataset.originalEmail;

    emailInput.addEventListener("input", () => {
      const currentVal = emailInput.value.trim();
      if (currentVal !== originalEmail && currentVal.length > 5 && currentVal.includes("@")) {
        sendOtpBtn.classList.remove("d-none");
        otpWrapper.classList.remove("d-none");
        otpInput.setAttribute("required", "required");
      } else {
        sendOtpBtn.classList.add("d-none");
        otpWrapper.classList.add("d-none");
        otpInput.removeAttribute("required");
        otpStatus.style.display = "none";
      }
    });

    sendOtpBtn.addEventListener("click", async () => {
      const newEmail = emailInput.value.trim();
      if (!newEmail || !newEmail.includes("@")) {
        alert("Please enter a valid email address.");
        return;
      }

      sendOtpBtn.disabled = true;
      sendOtpBtn.innerHTML = `<span class="spinner-border spinner-border-sm"></span> Sending...`;

      try {
        const response = await fetch("/settings/send-email-otp", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ newEmail })
        });

        const data = await response.json();

        if (data.success) {
          otpStatus.className = "otp-alert-box text-success d-block";
          otpStatus.innerText = "✓ Code sent! Check your inbox.";
          let timer = 60;
          const interval = setInterval(() => {
            sendOtpBtn.innerText = `Resend in ${timer}s`;
            timer--;
            if (timer < 0) {
              clearInterval(interval);
              sendOtpBtn.disabled = false;
              sendOtpBtn.innerHTML = `<i class="bi bi-envelope-arrow-up"></i> Resend OTP`;
            }
          }, 1000);
        } else {
          otpStatus.className = "otp-alert-box text-danger d-block";
          otpStatus.innerText = "✕ " + (data.message || "Failed to send code.");
          sendOtpBtn.disabled = false;
          sendOtpBtn.innerHTML = `<i class="bi bi-envelope-arrow-up"></i> Send OTP`;
        }
      } catch (err) {
        otpStatus.className = "otp-alert-box text-danger d-block";
        otpStatus.innerText = "✕ Network error sending code.";
        sendOtpBtn.disabled = false;
        sendOtpBtn.innerHTML = `<i class="bi bi-envelope-arrow-up"></i> Send OTP`;
      }
    });
  });
</script>