  <div class="currency-modal-sheet" onclick="event.stopPropagation()">
    <div class="currency-modal-head">
      <h4>Choose a currency</h4>
      <button class="btn btn-sm btn-light rounded-circle" id="closeCurrencyModalBtn" style="width: 36px; height: 36px;">
        <i class="bi bi-x-lg"></i>
      </button>
    </div>

    <!-- Currency Options Grid -->
    <div class="currency-grid-deck">
