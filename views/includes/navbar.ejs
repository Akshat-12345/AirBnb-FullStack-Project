        <span class="curr-card-name">United States Dollar</span>
        <span class="curr-card-code">USD &middot; $</span>
      </div>
      <div class="currency-option-card" data-code="EUR" data-symbol="€">
        <span class="curr-card-name">Euro</span>
        <span class="curr-card-code">EUR &middot; €</span>
      </div>
      <div class="currency-option-card" data-code="GBP" data-symbol="£">
        <span class="curr-card-name">British Pound</span>
        <span class="curr-card-code">GBP &middot; £</span>
      </div>
      <div class="currency-option-card" data-code="JPY" data-symbol="¥">
        <span class="curr-card-name">Japanese Yen</span>
        <span class="curr-card-code">JPY &middot; ¥</span>
      </div>
      <div class="currency-option-card" data-code="AED" data-symbol="د.إ">
        <span class="curr-card-name">Emirati Dirham</span>
        <span class="curr-card-code">AED &middot; د.إ</span>
      </div>
      <div class="currency-option-card" data-code="CAD" data-symbol="$">
        <span class="curr-card-name">Canadian Dollar</span>
        <span class="curr-card-code">CAD &middot; $</span>
      </div>
      <div class="currency-option-card" data-code="AUD" data-symbol="$">
        <span class="curr-card-name">Australian Dollar</span>
        <span class="curr-card-code">AUD &middot; $</span>
      </div>
      <div class="currency-option-card" data-code="SGD" data-symbol="$">
        <span class="curr-card-name">Singapore Dollar</span>
        <span class="curr-card-code">SGD &middot; $</span>
      </div>
    </div>
  </div>
</div>

<!-- ==========================================
     JAVASCRIPT: SCROLL SHRINK, CURRENCY, VOICE, AJAX
     ========================================== -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const navbar = document.getElementById("masterAtithiNavbar");
    const searchInput = document.getElementById("atithiSearchInput");
    const suggestionPanel = document.getElementById("atithiAutocompletePanel");
    const filterBtnToggle = document.getElementById("inlineFilterDropdownBtnToggle");
    const filterDropdownPanel = document.getElementById("atithiInlineFilterDropdownPanel");
    const inlineSliderInput = document.getElementById("inlineDropdownSliderInput");
    const inlineDisplayPriceLbl = document.getElementById("inlineDisplayPriceLbl");
    const closeApplyBtn = document.getElementById("inlineFilterPanelCloseApplyBtn");
    const micBtn = document.getElementById("voiceSearchTrigger");
    
    // Currency modal variables
    const currTrigger = document.getElementById("currencyModalTriggerBtn");
    const currModal = document.getElementById("atithiCurrencyModal");
    const currClose = document.getElementById("closeCurrencyModalBtn");
    const currCards = document.querySelectorAll(".currency-option-card");
    const currDisplay = document.getElementById("currentActiveCurrencyDisplay");

    let debounceTimer;

    // 🚀 1. DYNAMIC SCROLL SHRINK & EXPAND LISTENER
    window.addEventListener("scroll", () => {
      if (window.scrollY > 20) {
        navbar.classList.add("navbar-scrolled");
      } else {
        navbar.classList.remove("navbar-scrolled");
      }
    });

    // 🚀 2. MULTI-CURRENCY CONVERSION ENGINE & MODAL CONTROLS
    const exchangeRates = {
      INR: { symbol: "₹", rate: 1 },
      USD: { symbol: "$", rate: 0.012 },
      EUR: { symbol: "€", rate: 0.011 },
      GBP: { symbol: "£", rate: 0.0095 },
      JPY: { symbol: "¥", rate: 1.85 },
      AED: { symbol: "د.إ", rate: 0.044 },
      CAD: { symbol: "CA$", rate: 0.016 },
      AUD: { symbol: "AU$", rate: 0.018 },
      SGD: { symbol: "SG$", rate: 0.016 }
    };

    function applyCurrencyConversion(code) {
      const config = exchangeRates[code] || exchangeRates.INR;
      localStorage.setItem("atithi_currency", code);

      if (currDisplay) {
        currDisplay.textContent = `${code} (${config.symbol})`;
      }

      document.querySelectorAll("[data-base-price]").forEach(el => {
        const inrPrice = parseFloat(el.getAttribute("data-base-price"));
        if (!isNaN(inrPrice)) {
          const converted = Math.round(inrPrice * config.rate);
          el.innerHTML = `<bdi>${config.symbol}</bdi>${converted.toLocaleString()}`;
        }
      });

      document.querySelectorAll("[data-tax-base]").forEach(el => {
        const taxBase = parseFloat(el.getAttribute("data-tax-base"));
        if (!isNaN(taxBase)) {
          const converted = Math.round(taxBase * config.rate);
          el.innerHTML = `<bdi>${config.symbol}</bdi>${converted.toLocaleString()}`;
        }
      });

      if (inlineDisplayPriceLbl && inlineSliderInput) {
        const convertedMax = Math.round(parseFloat(inlineSliderInput.value) * config.rate);
        inlineDisplayPriceLbl.innerHTML = `max <bdi>${config.symbol}</bdi>${convertedMax.toLocaleString()}`;
      }

      window.dispatchEvent(new CustomEvent("atithi_currency_updated", { detail: { code, config } }));
    }

    if (currTrigger && currModal && currClose) {
      currTrigger.addEventListener("click", () => {
        currModal.classList.add("active-curr-modal");
      });

      currClose.addEventListener("click", () => {
        currModal.classList.remove("active-curr-modal");
      });

      currModal.addEventListener("click", (e) => {
        if (e.target === currModal) {
          currModal.classList.remove("active-curr-modal");
        }
      });

      currCards.forEach(card => {
        card.addEventListener("click", () => {
          currCards.forEach(c => c.classList.remove("selected-curr"));
          card.classList.add("selected-curr");
          const code = card.dataset.code;
          applyCurrencyConversion(code);
          currModal.classList.remove("active-curr-modal");
        });
      });

      const savedCurrency = localStorage.getItem("atithi_currency") || "INR";
      const activeCard = document.querySelector(`.currency-option-card[data-code="${savedCurrency}"]`);
      if (activeCard) {
        currCards.forEach(c => c.classList.remove("selected-curr"));
        activeCard.classList.add("selected-curr");
      }
      applyCurrencyConversion(savedCurrency);
    }

    // 🚀 3. FILTER PANEL TOGGLE
    if (filterBtnToggle && filterDropdownPanel) {
      filterBtnToggle.addEventListener("click", (e) => {
        e.stopPropagation();
        if (suggestionPanel) suggestionPanel.style.display = "none";
        const isShown = filterDropdownPanel.style.display === "block";
        filterDropdownPanel.style.display = isShown ? "none" : "block";
        filterBtnToggle.classList.toggle("active", !isShown);
      });
    }

    // 🚀 4. REALTIME GRID RE-HYDRATOR
    window.appendTextHtmlGrid = function() {
      const form = document.getElementById("atithiLiveSearchForm");
      if (!form) return;
      const formData = new FormData(form);
      const searchParams = new URLSearchParams(formData);

      if (window.location.pathname === "/listings" || window.location.pathname === "/") {
        fetch(`/listings?${searchParams.toString()}`)
          .then(res => res.text())
          .then(html => {
            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');
            const newContent = doc.querySelector('.row') || doc.querySelector('[class*="row-cols"]');
            const currentContent = document.querySelector('.row') || document.querySelector('[class*="row-cols"]');
            if (newContent && currentContent) {
              currentContent.innerHTML = newContent.innerHTML;
              const currentCurr = localStorage.getItem("atithi_currency") || "INR";
              applyCurrencyConversion(currentCurr);
            }
          });
      }
    };

    if (inlineSliderInput && inlineDisplayPriceLbl) {
      inlineSliderInput.addEventListener("input", (e) => {
        const savedCurr = localStorage.getItem("atithi_currency") || "INR";
        const config = exchangeRates[savedCurr] || exchangeRates.INR;
        const converted = Math.round(Number(e.target.value) * config.rate);
        inlineDisplayPriceLbl.innerHTML = `max <bdi>${config.symbol}</bdi>${converted.toLocaleString()}`;
      });
      inlineSliderInput.addEventListener("change", () => window.appendTextHtmlGrid());
    }

    document.querySelectorAll(".inline-auto-stream-trigger").forEach(el => {
      el.addEventListener("change", () => window.appendTextHtmlGrid());
    });

    if (closeApplyBtn) {
      closeApplyBtn.addEventListener("click", () => {
        filterDropdownPanel.style.display = "none";
        filterBtnToggle.classList.remove("active");
      });
    }

    // 🚀 5. VOICE SEARCH
    if (micBtn && ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window)) {
      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      const recognition = new SpeechRecognition();
      recognition.continuous = false;
      recognition.lang = 'en-IN';

      micBtn.addEventListener("click", () => {
        try {
          recognition.start();
          micBtn.classList.add("recording-active");
        } catch(err) {
          recognition.stop();
          micBtn.classList.remove("recording-active");
        }
      });

      recognition.onresult = (event) => {
        const transcript = event.results[0][0].transcript;
        if (searchInput) {
          searchInput.value = transcript;
          window.appendTextHtmlGrid();
          document.getElementById("atithiLiveSearchForm").submit();
        }
        micBtn.classList.remove("recording-active");
      };

      recognition.onerror = () => micBtn.classList.remove("recording-active");
      recognition.onend = () => micBtn.classList.remove("recording-active");
    }

    // 🚀 6. LIVE SEARCH AUTOCOMPLETE
    if (searchInput && suggestionPanel) {
      searchInput.addEventListener("input", () => {
        clearTimeout(debounceTimer);
        if (filterDropdownPanel) {
          filterDropdownPanel.style.display = "none";
          filterBtnToggle.classList.remove("active");
        }

        const query = searchInput.value.trim().toLowerCase();
        if (query.length < 1) {
          suggestionPanel.style.display = "none";
          window.appendTextHtmlGrid();
          return;
        }

        debounceTimer = setTimeout(() => {
          window.appendTextHtmlGrid();

          fetch(`/listings?search=${encodeURIComponent(query)}&json=true`)
            .then(res => res.json())
            .then(data => {
              suggestionPanel.innerHTML = "";
              if (!data.success || !data.listings || data.listings.length === 0) {
                suggestionPanel.innerHTML = `<div class="text-muted small p-3 text-center">No stays found matching "${query}"</div>`;
                suggestionPanel.style.display = "block";
                return;
              }

              const savedCurr = localStorage.getItem("atithi_currency") || "INR";
              const config = exchangeRates[savedCurr] || exchangeRates.INR;

              data.listings.slice(0, 5).forEach(listing => {
                const title = listing.title || "Atithi Stay";
                const location = listing.location || "India";
                
                let price = "N/A";
                if (listing.price) {
                  const converted = Math.round(Number(listing.price) * config.rate);
                  price = `<bdi>${config.symbol}</bdi>${converted.toLocaleString()}`;
                }

                const imgSrc = (listing.images && listing.images.length > 0) 
                  ? listing.images[0].url 
                  : (listing.image && listing.image.url ? listing.image.url : "https://images.unsplash.com/photo-1584132967334-10e028bd69f7");

                const item = document.createElement("div");
                item.className = "suggestion-item";
                item.innerHTML = `
                  <img src="${imgSrc}" class="suggestion-thumb" alt="stay">
                  <div class="flex-grow-1 min-w-0">
                    <div class="suggestion-title text-truncate">${title}</div>
                    <div class="suggestion-subtitle text-truncate">${location}</div>
                  </div>
                  <div class="suggestion-price">${price}</div>
                `;

                item.addEventListener("click", () => {
                  window.location.href = `/listings/${listing._id}`;
                });

                suggestionPanel.appendChild(item);
              });

              suggestionPanel.style.display = "block";
            })
            .catch(() => {
              suggestionPanel.style.display = "none";
            });
        }, 250);
      });
    }

    // Dismiss on click outside
    document.addEventListener("click", (e) => {
      if (filterDropdownPanel && !filterDropdownPanel.contains(e.target) && !filterBtnToggle.contains(e.target)) {
        filterDropdownPanel.style.display = "none";
        filterBtnToggle.classList.remove("active");
      }
      if (suggestionPanel && !searchInput.contains(e.target) && !suggestionPanel.contains(e.target)) {
        suggestionPanel.style.display = "none";
      }
    });
  });
</script>